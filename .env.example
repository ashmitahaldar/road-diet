GEMINI_API_KEY=
GEMINI_MODEL=
# Optional: an image model for the results postcard (needs a plan with image quota). Unset, the game draws its own.
GEMINI_IMAGE_MODEL=
DATABASE_URL=
# Only for `npm test`: tests create and drop throwaway schemas here. Never point it at a real database.
TEST_DATABASE_URL=
PORT=3000
NODE_ENV=development
