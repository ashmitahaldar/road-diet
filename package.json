{
  "name": "road-diet",
  "private": true,
  "workspaces": [
    "client",
    "server",
    "shared"
  ],
  "scripts": {
    "dev": "npm run dev -w @road-diet/server & npm run dev -w @road-diet/client",
    "build": "npm run build --workspaces --if-present",
