{
  "name": "@road-diet/server",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=../.env src/index.ts",
    "start": "tsx src/index.ts",
    "build": "tsc",
    "test": "vitest run",
    "migrate": "tsx --env-file-if-exists=../.env src/scripts/migrate.ts",
    "seed": "tsx --env-file-if-exists=../.env src/scripts/seed.ts",
    "refresh": "tsx --env-file-if-exists=../.env src/scripts/refresh.ts"
  },
  "dependencies": {
    "@road-diet/shared": "*",
    "express": "^5",
    "pg": "^8.23.1",
    "tsx": "^4",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/express": "^5",
    "@types/node": "^24.13.3",
    "@types/pg": "^8.23.1",
    "typescript": "~6.0.2",
    "vitest": "~4.0.18"
  }
}
